# ---------------------------------------------------------------------------
# Project root protection
# ---------------------------------------------------------------------------
# Only the public/ folder is meant to be reachable from the web. On a correctly
# configured server the document root points there and this file never does
# anything at all.
#
# It exists because that is not how most of these installs end up. A buyer
# extracts the ZIP into public_html/mysite/ and opens mysite/public/ in a
# browser, and it works, so nothing gets changed. The whole project is then
# sitting inside the web root, where .env - the database password, the app key
# that signs every session cookie, the payment gateway secrets - is one URL
# away from anybody who asks for it.
#
# So: everything outside public/ is refused here, by name and by directory.
#
# Apache only reads this file if the host allows overrides (AllowOverride All,
# which is the default in XAMPP and on virtually all shared hosting). It is a
# safety net, not a substitute for pointing the document root at public/.

# No directory listings anywhere in the project.
Options -Indexes

# Dotfiles: .env, .env.backup, .git/config, .htpasswd and friends.
# Matched on the file name, so public/.well-known/acme-challenge/<token> -
# how Let's Encrypt proves domain ownership - still works.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Build files, dependency manifests, logs, database dumps and scripts. None of
# these should ever be fetched, and several of them describe the site's
# dependencies precisely enough to look up known vulnerabilities.
<FilesMatch "(?i)^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml(\.dist)?|vite\.config\.(js|ts)|tailwind\.config\.js|postcss\.config\.js|README\.md|CHANGELOG\.md|LICENSE|.*\.(env|log|sql|sh|bat|cmd|ini|yml|yaml|lock|bak|old|orig|save|swp|dist))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# The application itself. A request for any of these directories is refused
# outright - source code, compiled views, logs, uploaded files and the private
# downloads folder all live under them.
#
# public/ is deliberately absent from the list, and is unaffected in any case:
# it has its own .htaccess, and rewrite rules are not inherited by a directory
# that starts its own rewrite engine.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bootstrap|config|database|lang|node_modules|resources|routes|storage|tests|themes|vendor)(/|$) - [F,L]
</IfModule>

# There is deliberately no fallback for a server without mod_rewrite. The only
# way to refuse those directories without it is a blanket rule on .php files,
# which subdirectories inherit - including public/, whose index.php is the
# entire site. A server missing mod_rewrite cannot run this CMS anyway, so the
# trade is a broken home page in exchange for nothing.
