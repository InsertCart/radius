*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
# The install lock. Committing it ships a CMS that believes it is already set
# up, so the buyer never sees the setup wizard and cannot get past it.
/storage/installed
# Written by the updater; describes this machine, not the product.
/storage/app/shipped-checksums.json
/storage/app/update-pending.json
/storage/app/update-last.json
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# Written by the release workflow while it assembles the GitHub release.
/release-notes.md

# Only the two bundled themes ship with the CMS. Any other theme is installed
# by the user (or from a package) and must never be committed.
/themes/*
!/themes/default
!/themes/storefront
/public/themes/*
!/public/themes/.htaccess
!/public/themes/default
!/public/themes/storefront

# Plugins are installed per site and distributed on their own - never in
# this repository, and never in a release. Only the folder guard is kept.
# Plugins developed here (theme-preview included) live in plugins/ locally
# and are versioned in their own repositories.
/plugins/*
!/plugins/.htaccess
/public/plugins/*
!/public/plugins/.htaccess

# Packaged theme ZIPs (cms:theme-package output).
theme-packages/
/*.zip
