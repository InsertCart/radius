<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # One address per page.
    #
    # The .htaccess in the folder above serves this site without /public in the
    # address, so /welcome and /public/welcome both render the same page. Two
    # addresses for one page split a search engine's ranking signals between
    # them, and the one it settles on is rarely the tidy one.
    #
    # The rule lives here rather than with its twin upstairs because
    # mod_rewrite does not inherit a parent folder's rules into a directory
    # that has rules of its own - so a redirect written up there never sees the
    # requests it is meant to catch.
    #
    # THE_REQUEST is the browser's original request line rather than the
    # rewritten path, so only an address somebody actually typed is redirected;
    # the internal rewrite upstairs cannot trigger it, and nothing loops.
    RewriteCond %{THE_REQUEST} \s(/(?:[^\s?]*/)?)public/([^\s?]*) [NC]
    RewriteRule ^ %1%2 [R=301,L,NE]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    #
    # Read from THE_REQUEST, for the same reason as the rule above. Laravel's
    # stock version reads REQUEST_URI, which - once the folder above has
    # rewritten the request into public/ - already contains /public, so
    # /shop/ was sent to /public/shop and then redirected a second time. The
    # original query string is carried over by mod_rewrite on its own; NE
    # keeps an already-encoded path from being encoded twice.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} \s(/[^\s?]*[^\s?/])/+(?:\?\S*)?\s
    RewriteRule ^ %1 [L,R=301,NE]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
