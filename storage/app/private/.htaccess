# ---------------------------------------------------------------------------
# Private storage — paid downloads
# ---------------------------------------------------------------------------
# Nothing in this folder has a web address. It sits outside the document root,
# and no symlink points at it, so Apache should never be asked for these files
# at all.
#
# This file exists for the day that stops being true: a buyer who points a
# virtual host at the project root instead of public/, a control panel that
# helpfully "fixes" the document root, a stray symlink. In any of those cases
# the customer's paid download would be a URL away, and the payment check in
# the application would count for nothing.
#
# So: refuse everything, unconditionally. There is no allowlist here, because
# there is no file in here that a browser is ever meant to fetch directly.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes -ExecCGI -Includes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<FilesMatch ".*">
    SetHandler none
</FilesMatch>
