# ---------------------------------------------------------------------------
# nginx configuration for Radius
# ---------------------------------------------------------------------------
# nginx does not read .htaccess files. Every .htaccess shipped with this CMS is
# ignored on an nginx server, which means the routing rules and the rules that
# keep .env and the uploads folder out of reach all have to be stated here
# instead.
#
# The application-level protections are unaffected: uploads are still checked
# before they are stored, SVGs are still sanitised, and paid downloads still
# live on a disk with no URL and leave only through a controller that has
# checked the order. What this file restores is the web server's half.
#
# On CloudPanel, Plesk or any panel that manages vhosts for you, see the notes
# at the bottom - you usually only need to set the site root correctly and add
# the two location blocks under "Vhost".

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    # The document root is the public/ folder, NOT the project folder.
    #
    # This one line is the whole security model. Point it at the project folder
    # and .env, the source code and the database backups are all one URL away,
    # because the .htaccess that would have refused them does nothing here.
    root /home/radius/htdocs/example.com/public;

    index index.php;
    charset utf-8;

    client_max_body_size 64M;   # large enough for theme ZIPs and media uploads

    # Laravel's front controller. Without this every page except the home page
    # returns 404, because nginx looks for a file or directory that is not
    # there and gives up rather than handing the URL to PHP.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # One address per page.
    #
    # With the root set to public/ above, /public/welcome is not a second copy
    # of /welcome - it simply does not exist. This turns that dead end into a
    # redirect, which matters most for anyone who bookmarked the address while
    # the site was served from the project folder, and keeps a stray /public
    # link from being indexed as its own page.
    #
    # Delete it if this site has a page whose own slug starts with "public".
    location ~ ^/public/(.*)$ {
        return 301 /$1;
    }

    # robots.txt is generated by the CMS from your SEO settings, not served
    # from disk - so there is deliberately no `location = /robots.txt` block
    # here. Adding one makes nginx look for a file that does not exist and
    # return 404 instead of handing the URL to PHP, which silently costs you
    # the robots.txt every crawler asks for. The same applies to sitemap.xml.
    #
    # favicon.ico is a real file, but it falls through to the front controller
    # too, so replacing it with a dynamic one later needs no config change.
    location = /favicon.ico {
        try_files $uri /index.php?$query_string;
        access_log off;
        log_not_found off;
    }

    error_page 404 /index.php;

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;   # match your PHP version
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;

        fastcgi_read_timeout 300;   # self-updates unpack ~9,000 files
    }

    # -----------------------------------------------------------------------
    # Uploads
    # -----------------------------------------------------------------------
    # /storage/ is the symlink to storage/app/public: visitor-facing images and
    # documents. Nothing in it may ever be executed.
    #
    # Files are already checked on the way in - an upload whose name and
    # contents disagree is refused, and anything carrying PHP is rejected - so
    # this is the second line of defence, for the day a bug or a future change
    # gets one past that.
    location ^~ /storage/ {
        location ~* \.(php|phar|phtml|pht|phps|cgi|pl|py|sh|bash|lua|rb)$ {
            deny all;
        }

        # HTML is refused as well, and not for tidiness: a page served from
        # this folder runs on the site's own origin, so script inside it reads
        # the admin's session cookie. The CMS already refuses to store HTML
        # here - an upload whose name and contents disagree never lands - but
        # this is the layer that holds if that check is ever bypassed.
        location ~* \.(html?|shtml|xhtml|xml|svgz)$ {
            deny all;
        }

        # Documents download rather than opening inside the site.
        location ~* \.(zip|docx?|xlsx?)$ {
            add_header Content-Disposition "attachment" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        # Browsers must use the declared type rather than guessing one from the
        # contents - guessing is how an image with HTML inside it gets rendered
        # as a page.
        add_header X-Content-Type-Options "nosniff" always;

        # An SVG opened directly must not be able to run script, even if one
        # slipped past the upload cleaner.
        location ~* \.svg$ {
            add_header Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; sandbox" always;
            add_header X-Content-Type-Options "nosniff" always;
        }
    }

    # Published theme assets. Same rule: static files only.
    location ^~ /themes/ {
        location ~* \.(php|phar|phtml|pht|phps|cgi|pl|py|sh)$ {
            deny all;
        }
    }

    # Dotfiles: .env, .git/config, .htpasswd. Matched by name, so
    # /.well-known/acme-challenge/<token> still works for Let's Encrypt.
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    # -----------------------------------------------------------------------
    # Belt and braces
    # -----------------------------------------------------------------------
    # With the root set to public/ above, none of these paths is reachable in
    # the first place. They are listed anyway because the single most common
    # way to break this is to point the root at the project folder - and if
    # that ever happens, these keep the credentials and the source out of
    # reach instead of serving them.
    location ~ ^/(app|bootstrap|config|database|lang|node_modules|resources|routes|storage/app|storage/framework|storage/logs|tests|vendor)/ {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* ^/(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|README\.md|LICENSE|SECURITY\.md)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    location ~* \.(env|log|sql|sh|bak|old|orig|save|swp|dist)$ {
        deny all;
        access_log off;
        log_not_found off;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}

# ---------------------------------------------------------------------------
# CloudPanel
# ---------------------------------------------------------------------------
# CloudPanel builds the server block for you, so do not paste the whole file.
#
#  1. Create the site as a PHP site (PHP 8.2 or newer).
#
#  2. Set the Site Root so it ends in /public. CloudPanel calls this "Site
#     Root" under the site's Settings. This is the step that matters: leaving
#     it at the project folder exposes .env to anyone who asks for it.
#
#  3. Under the site's "Vhost" tab, CloudPanel's Laravel template already has
#     the try_files line. Add the `location ^~ /storage/`, `location ^~
#     /themes/` and the dotfile block from above, then save - CloudPanel
#     reloads nginx itself.
#
#  4. Confirm it worked: in the admin panel open System -> Security and run the
#     check. It asks your own server for .env and reports what it actually got
#     back, which is the only way to know for certain.
#
# Plesk: Apache is usually in front of nginx, in which case the shipped
# .htaccess files do work. If you have switched to nginx-only, the same
# applies as CloudPanel.
