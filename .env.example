APP_NAME=Radius
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Set only when this site sits behind a load balancer, Cloudflare or another
# reverse proxy: the proxy's IP, a comma-separated list, or '*' when the app
# can only ever be reached through it. Left empty, forwarded headers are
# ignored - which is correct for a normal Apache or shared-hosting install,
# and stops a visitor spoofing their own IP address.
TRUSTED_PROXIES=

APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The setup wizard fills these in. Leave them as they are.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions and cache are kept in files, not in the database.
#
# This matters on a fresh install: the wizard needs somewhere to keep a session
# before it has a database to keep one in, and a database-backed session sends
# the very first request looking for a `sessions` table that nothing has created
# yet. Files work everywhere and need no setup. Switch to `database` afterwards
# if you prefer, once the tables exist.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# `sync` runs queued work immediately, in the same request. Most shared hosting
# has no way to keep a queue worker running, so anything queued would otherwise
# sit there forever.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# CMS
# ----------------------------------------------------------------------
# Moves the admin panel off the predictable /admin path.
CMS_ADMIN_PREFIX=admin

# Disk used for uploads. 'public' works everywhere; switch to s3 if configured.
CMS_MEDIA_DISK=public

# Where paid downloads are stored. Must be a disk with no public URL, or the
# payment check can be bypassed by requesting the file directly.
CMS_DOWNLOADS_DISK=private

# ----------------------------------------------------------------------
# Updates
# ----------------------------------------------------------------------
# The address of the JSON file describing your latest release. Leave blank to
# switch updates off entirely. See the README for the file's format.
CMS_UPDATE_URL=https://api.github.com/repos/InsertCart/radius/releases/latest

# Hours between automatic checks. The check is cached, runs off an admin page
# load, and never blocks it.
CMS_UPDATE_CHECK_HOURS=24

# Both of these exist for testing against a local file server and should stay
# true in production: they are what stop a tampered download from installing
# itself as program code on your server.
CMS_UPDATE_REQUIRE_CHECKSUM=true
CMS_UPDATE_REQUIRE_HTTPS=true

# ----------------------------------------------------------------------
# Theme directory
# ----------------------------------------------------------------------
# Appearance -> Browse themes lists free themes from this catalogue file and
# installs them in one click. Set ENABLED to false to remove the screen and
# every request it makes. Browsing sends no information about this site.
CMS_MARKETPLACE_ENABLED=true
CMS_MARKETPLACE_URL=https://www.insertcart.com/marketplace/themes.json

# Hours the catalogue is remembered.
CMS_MARKETPLACE_CACHE_HOURS=12

# As with updates, keep these true in production. Installed themes become code
# on your server.
CMS_MARKETPLACE_REQUIRE_CHECKSUM=true
CMS_MARKETPLACE_REQUIRE_HTTPS=true

# Set false to stop the admin panel loading theme screenshots from the
# directory's server.
CMS_MARKETPLACE_REMOTE_IMAGES=true

# ----------------------------------------------------------------------
# Email providers that use an API key
# ----------------------------------------------------------------------
# Kept out of the database on purpose: a leaked backup should not hand these
# over. Choose the provider in the admin panel, then set its key here.
RESEND_KEY=
POSTMARK_TOKEN=

# ----------------------------------------------------------------------
# Firebase
# ----------------------------------------------------------------------
# Path to the service-account JSON used to send push notifications.
# Defaults to storage/app/firebase/service-account.json when left blank.
FIREBASE_CREDENTIALS=
